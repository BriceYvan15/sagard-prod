model CrmLead {
  id                  String          @id @default(uuid())
  reference           String          @unique
  title               String
  contactName         String?
  contactEmail        String?
  contactPhone        String?
  companyName         String?
  clientId            String?
  client              Client?         @relation(fields: [clientId], references: [id])
  assignedToId        String?
  stage               LeadStage       @default(NOUVEAU)
  source              LeadSource      @default(APPEL_ENTRANT)
  priority            LeadPriority    @default(NORMALE)
  serviceType         LeadServiceType @default(GARDIENNAGE_STATIQUE)
  siteAddress         String?
  siteCity            String?
  siteSurface         Float?
  nbAgentsEstimated   Int             @default(0)
  nbShifts            Int             @default(1)
  armedRequired       Boolean         @default(false)
  canineRequired      Boolean         @default(false)
  riskLevel           String          @default("FAIBLE")
  targetStartDate     DateTime?       @db.Date
  estimatedRevenue    Decimal?        @db.Decimal(15, 2)
  currency            String          @default("XOF")
  probability         Int             @default(10)  // 0-100 %
  notes               String?
  lostReason          String?
  wonDate             DateTime?
  lostDate            DateTime?
  nextActionDate      DateTime?       @db.Date
  nextActionNote      String?
  createdById         String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  activities          LeadActivity[]
  invoices            Invoice[]

  @@index([stage, priority])
  @@index([assignedToId, stage])
  @@index([createdById])
  @@map("crm_leads")
}

model LeadActivity {
  id          String   @id @default(uuid())
  leadId      String
  lead        CrmLead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        String   // APPEL, EMAIL, RDV, NOTE, RELANCE
  summary     String
  details     String?
  date        DateTime @default(now())
  performedBy String?
  createdAt   DateTime @default(now())

  @@index([leadId, date])
  @@map("lead_activities")
}

