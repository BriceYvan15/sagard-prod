model SiteEquipment {
  id                      String              @id @default(uuid())
  code                    String?             @unique
  barcode                 String?
  name                    String
  category                EquipmentCategory   @default(TENUE)
  state                   EquipmentState      @default(EN_STOCK)
  siteId                  String?
  site                    Site?               @relation(fields: [siteId], references: [id])
  employeeId              String?
  purchaseDate            DateTime?           @db.Date
  purchaseValue           Decimal?            @db.Decimal(15, 2)
  currency                String              @default("XOF")
