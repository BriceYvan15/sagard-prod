model DailyReport {
  id                String           @id @default(uuid())
  reference         String           @unique
  date              DateTime         @db.Date
  siteId            String
  site              Site             @relation(fields: [siteId], references: [id])
  contractId        String?
  shift             DailyReportShift @default(JOUR)
  chiefAgentId      String?
  agentsExpected    Int              @default(0)
  agentCount        Int              @default(0)
  state             DailyReportState @default(BROUILLON)
  weather           WeatherCondition?
  visitorsCount     Int              @default(0)
  vehiclesInCount   Int              @default(0)
  vehiclesOutCount  Int              @default(0)
  roundsDone        Int              @default(0)
  summary           String?
  activities        String?
  handoverTo        String?
  keysCount         Int              @default(0)
  nextShiftNotes    String?
  validatorId       String?
  validationDate    DateTime?
  submittedBy       String?
  attachmentUrls    String[]         @default([])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  agents            DailyReportAgent[]
  incidents         Incident[]       @relation("IncidentDailyReport")

  @@unique([siteId, date, shift])
  @@index([siteId, date])
  @@map("daily_reports")
}

// Table de liaison many-to-many DailyReport Ã¢â€ â€ Agent (agents prÃƒÂ©sents)
model DailyReportAgent {
  id            String       @id @default(uuid())
  reportId      String
  report        DailyReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  agentId       String
  createdAt     DateTime     @default(now())

  @@unique([reportId, agentId])
  @@map("daily_report_agents")
}

