model Client {
  id            String       @id @default(uuid())
  code          String?      @unique
  name          String
  legalName     String?
  segment       String        @default("AUTRE")
  sector        String?
  taxId         String?      @unique
  rccm          String?      // Registre du Commerce et du CrÃƒÂ©dit Mobilier
  ncc           String?      // NumÃƒÂ©ro de Compte Contribuable
  vat           String?
  contactFirstName String?
  contactLastName  String?
  cniNumber     String?      // NÃ‚Â° CNI / Passeport du contact principal
  // CoordonnÃƒÂ©es directes (comme res.partner)
  phone         String?
  phone2        String?      // Contact 2
  mobile        String?
  email         String?
  website       String?
  // Adresse
  address       String
  street2       String?
  zip           String?
  city          String
  district      String?      // Commune
  quartier      String?      // Quartier
  country       String?      @default("CÃƒÂ´te d'Ivoire")
  // CoordonnÃƒÂ©es GPS
  latitude      Float?
  longitude     Float?
  notes         String?
  status        ClientStatus @default(PROSPECT)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  createdById   String?

  contacts      ClientContact[]
  contracts     ClientContract[]
  sites         Site[]
  invoices      Invoice[]
  complaints    Complaint[]
  history       ClientHistory[]
  leads         CrmLead[]

  @@map("clients")
}

model ClientContact {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId      String?  @unique
  user        User?    @relation(fields: [userId], references: [id])
  firstName   String
  lastName    String
  email       String?
  phone       String
  whatsapp    String?
  position    String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())

  sitesOnSite Site[]   @relation("SiteContact")

  @@map("client_contacts")
}

model ClientHistory {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  action      String
  details     String?
  performedBy String
  createdAt   DateTime @default(now())

  @@map("client_history")
}

// (relation back to AgentDeployment via DeploymentContract)
model ClientContract {
  id                  String         @id @default(uuid())
  reference           String         @unique
  title               String?
  clientId            String
  client              Client         @relation(fields: [clientId], references: [id])
  contractType        ContractType   @default(GARDIENNAGE_STATIQUE)
  type                String?
  description         String?
  signatureDate       DateTime?
  startDate           DateTime
  endDate             DateTime?
  durationMonths      Int?
  autoRenew           Boolean        @default(false)
  noticeDays          Int            @default(30)
  monthlyAmount       Decimal        @db.Decimal(15, 2)
  setupAmount         Decimal        @db.Decimal(15, 2) @default(0)
  currency            String         @default("XOF")
  invoicingFrequency  InvoicingFrequency @default(MENSUELLE)
  paymentTermDays     Int            @default(30)
  nbAgentsRequired    Int            @default(0)
  nbShifts            ShiftCount     @default(ONE)
  nbHoursMonth        Float?
  // Site principal (en plus des SiteContract m2m)
  siteId              String?
  site                Site?          @relation("ContractMainSite", fields: [siteId], references: [id])
  // ChargÃƒÂ© d'affaires (commercial)
  assignedUserId      String?
  status              ContractStatus @default(BROUILLON)
  documentUrl         String?
  createdById         String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  sites               SiteContract[]
  invoices            Invoice[]
  history             ContractHistory[]
  deployments         AgentDeployment[] @relation("DeploymentContract")

  @@map("client_contracts")
}

model ContractHistory {
  id          String         @id @default(uuid())
  contractId  String
  contract    ClientContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  action      String
  details     String?
  performedBy String
  createdAt   DateTime       @default(now())

  @@map("contract_history")
}

