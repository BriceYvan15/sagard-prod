model Key {
  id               String      @id @default(uuid())
  name             String
  code             String
  siteId           String
  site             Site        @relation(fields: [siteId], references: [id])
  keyType          KeyType     @default(PORTE)
  state            KeyState    @default(DISPONIBLE)
  currentHolderId  String?
  notes            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  movements        KeyMovement[]

  @@unique([code, siteId])
  @@index([siteId, state])
  @@map("keys")
}

model KeyMovement {
  id            String          @id @default(uuid())
  keyId         String
  key           Key             @relation(fields: [keyId], references: [id], onDelete: Cascade)
  movementType  KeyMovementType
  date          DateTime        @default(now())
  employeeId    String?         // agent or employee
  visitorLogId  String?
  visitorLog    VisitorLog?     @relation("KeyMovementVisitor", fields: [visitorLogId], references: [id])
  issuedById    String?         // security agent who issued
  notes         String?
  createdAt     DateTime        @default(now())

  @@index([keyId, date])
  @@map("key_movements")
}

