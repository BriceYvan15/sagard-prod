// Ã¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢Â

model TreasuryAccount {
  id              String   @id @default(uuid())
  name            String
  type            String   // BANQUE, CAISSE, MOBILE_MONEY
  bankName        String?
  accountNumber   String?
  balance         Decimal  @db.Decimal(15, 2) @default(0)
  currency        String   @default("XOF")
  paymentMethods  String[] // PaymentMethod values that credit this account
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  payments        Payment[]
  transactions    TreasuryTransaction[]

  @@map("treasury_accounts")
}

model TreasuryTransaction {
  id                String   @id @default(uuid())
  treasuryAccountId String
  treasuryAccount   TreasuryAccount @relation(fields: [treasuryAccountId], references: [id])
  type              String   // CREDIT, DEBIT
  amount            Decimal  @db.Decimal(15, 2)
  description       String?
  paymentId         String?  @unique
  payment           Payment? @relation(fields: [paymentId], references: [id])
  reference         String?
  createdAt         DateTime @default(now())

  @@index([treasuryAccountId, createdAt])
  @@map("treasury_transactions")
}

// ExtraService model
enum ExtraServiceStatus {
  EN_ATTENTE
  VALIDEE
  ANNULEE
}

model ExtraService {
  id              String              @id @default(uuid())
  agentId         String
  agent           Agent               @relation(fields: [agentId], references: [id])
  date            DateTime            @db.Date
  hours           Float               @default(12)
  amount          Decimal             @db.Decimal(15, 2) @default(2500)
  description     String?
  assignedById    String?
  assignedByName  String?
  status          ExtraServiceStatus  @default(EN_ATTENTE)
  createdAt       DateTime            @default(now())

  @@index([agentId, date])
  @@map("extra_services")
}
