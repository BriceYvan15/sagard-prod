enum BillingRunState {
  BROUILLON
  EXECUTE
  ANNULE
}

model BillingRun {
  id                  String         @id @default(uuid())
  reference           String         @unique
  period              String         // ex. "2026-05"
  invoiceDate         DateTime
  invoicingFrequency  InvoicingFrequency @default(MENSUELLE)
  state               BillingRunState @default(BROUILLON)
  totalAmount         Decimal        @db.Decimal(15, 2) @default(0)
  currency            String         @default("XOF")
  notes               String?
  createdById         String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  invoices            Invoice[]

  @@map("billing_runs")
}

model Invoice {
  id              String        @id @default(uuid())
  reference       String        @unique
  type            InvoiceType   @default(FACTURE)
  clientId        String?
  client          Client?       @relation(fields: [clientId], references: [id])
  leadId          String?
  lead            CrmLead?      @relation(fields: [leadId], references: [id])
  contractId      String?
  contract        ClientContract? @relation(fields: [contractId], references: [id])
  billingRunId    String?
  billingRun      BillingRun?   @relation(fields: [billingRunId], references: [id])
  issueDate       DateTime      @default(now())
  dueDate         DateTime
  deliveryDate    DateTime?
  status          InvoiceStatus @default(BROUILLON)
  currency        String        @default("XOF")
  subtotal        Decimal       @db.Decimal(15, 2)
  taxRate         Decimal       @db.Decimal(5, 2) @default(0)
  taxAmount       Decimal       @db.Decimal(15, 2) @default(0)
  totalAmount     Decimal       @db.Decimal(15, 2)
  paidAt          DateTime?
  paidAmount      Decimal?      @db.Decimal(15, 2)
  notes           String?
  paymentMethod   PaymentMethod?
  qrCodeData      String?
  createdById     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  lines           InvoiceLine[]
  payments        Payment[]
  history         InvoiceHistory[]
  notifications   Notification[]

  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  code        String
  description String
  details     String?
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(15, 2)
  discount    Decimal @db.Decimal(5, 2) @default(0)
  total       Decimal @db.Decimal(15, 2)

  @@map("invoice_lines")
}

model Payment {
  id                  String   @id @default(uuid())
  invoiceId           String
  invoice             Invoice  @relation(fields: [invoiceId], references: [id])
  amount              Decimal  @db.Decimal(15, 2)
  currency            String   @default("XOF")
  method              String
  reference           String?
  paidAt              DateTime @default(now())
  recordedBy          String?
  notes               String?
  treasuryAccountId   String?
  treasuryAccount     TreasuryAccount? @relation(fields: [treasuryAccountId], references: [id])
  treasuryTransaction TreasuryTransaction?

  @@map("payments")
}

model InvoiceHistory {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  action      String
  details     String?
  performedBy String
  createdAt   DateTime @default(now())

  @@map("invoice_history")
}

