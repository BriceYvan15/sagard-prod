// ControllerPatrol = sagard.control.visit (visite de contrÃƒÂ´le par superviseur)
model ControllerPatrol {
  id                  String              @id @default(uuid())
  reference           String?             @unique
  controllerId        String
  siteId              String
  site                Site                @relation(fields: [siteId], references: [id])
  contractId          String?
  visitDatetime       DateTime            @default(now())
  visitType           ControlVisitType    @default(ROUTINE)
  arrivedAt           DateTime?
  leftAt              DateTime?
  durationMinutes     Int?
  agentsExpected      Int                 @default(0)
  agentsChecked       Int                 @default(0)
  uniformOk           Boolean             @default(false)
  equipmentOk         Boolean             @default(false)
  postureOk           Boolean             @default(false)
  registerOk          Boolean             @default(false)
  rating              Int?                // 1..5 ÃƒÂ©toiles
  state               ControlVisitState   @default(BROUILLON)
  observations        String?
  actionsTaken        String?
  notes               String?
  photoUrl            String?
  latitude            Float?
  longitude           Float?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  agentChecks         PatrolAgentCheck[]
  incidents           Incident[]          @relation("IncidentControlVisit")

  @@index([siteId, visitDatetime])
  @@index([controllerId, visitDatetime])
  @@map("controller_patrols")
}

