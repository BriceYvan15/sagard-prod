model Payroll {
  id          String        @id @default(uuid())
  month       Int
  year        Int
  status      PayrollStatus @default(BROUILLON)
  totalBrut   Decimal       @db.Decimal(15, 2) @default(0)
  totalNet    Decimal       @db.Decimal(15, 2) @default(0)
  processedAt DateTime?
  approvedBy  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  lines       PayrollLine[]

  @@unique([month, year])
  @@map("payrolls")
}

model PayrollLine {
  id               String   @id @default(uuid())
  payrollId        String
  payroll          Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  agentId          String
  agent            Agent    @relation(fields: [agentId], references: [id])
  daysWorked       Int      @default(0)
  hoursWorked      Float    @default(0)
  baseSalary       Decimal  @db.Decimal(15, 2)
  bonuses          Decimal  @db.Decimal(15, 2) @default(0)
  deductions       Decimal  @db.Decimal(15, 2) @default(0)
  grossSalary      Decimal  @db.Decimal(15, 2)
