model PatrolPoint {
  id                  String   @id @default(uuid())
  name                String
  code                String   @unique
  siteId              String
  site                Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  sequence            Int      @default(10)
  locationDescription String?
  latitude            Float?
  longitude           Float?
  expectedIntervalMin Int      @default(60)
  instructions        String?
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())

  checks              PatrolCheck[]

  @@index([siteId, sequence])
  @@map("patrol_points")
}

model PatrolRound {
  id            String           @id @default(uuid())
  reference     String           @unique
  siteId        String
  site          Site             @relation(fields: [siteId], references: [id])
  agentId       String
  agent         Agent            @relation(fields: [agentId], references: [id])
  dateStart     DateTime         @default(now())
  dateEnd       DateTime?
  durationMin   Float            @default(0)
  state         PatrolRoundState @default(EN_COURS)
  pointsTotal   Int              @default(0)
  pointsDone    Int              @default(0)
  completionPct Float            @default(0)
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  checks        PatrolCheck[]

  @@index([siteId, dateStart])
  @@index([agentId, dateStart])
  @@map("patrol_rounds")
}

model PatrolCheck {
  id          String       @id @default(uuid())
  roundId     String
  round       PatrolRound  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  pointId     String?
  point       PatrolPoint? @relation(fields: [pointId], references: [id])
  pointCode   String?
  checkTime   DateTime     @default(now())
  latitude    Float?
  longitude   Float?
  photoUrl    String?
  note        String?
  hasAnomaly  Boolean      @default(false)

  @@index([roundId, checkTime])
  @@map("patrol_checks")
}

