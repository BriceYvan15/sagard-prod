model Alert {
  id                String         @id @default(uuid())
  reference         String         @unique
  siteId            String?
  agentId           String?
  alertType         AlertType      @default(SOS)
  severity          AlertSeverity  @default(WARNING)
  message           String?
  latitude          Float?
  longitude         Float?
  state             AlertState     @default(NOUVELLE)
  acknowledgedById  String?
  acknowledgedAt    DateTime?
  responseTimeMin   Float          @default(0)
  resolvedAt        DateTime?
  incidentId        String?
  incident          Incident?      @relation("AlertIncident", fields: [incidentId], references: [id])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([state, createdAt])
  @@index([siteId, createdAt])
  @@map("alerts")
}

model PatrolAgentCheck {
  id          String           @id @default(uuid())
  patrolId    String
  patrol      ControllerPatrol @relation(fields: [patrolId], references: [id], onDelete: Cascade)
  agentId     String
  checkedAt   DateTime
  status      String
  notes       String?

  @@map("patrol_agent_checks")
}

model ControllerLocation {
  id             String   @id @default(uuid())
  controllerId   String
  latitude       Float
  longitude      Float
  accuracy       Float?
  recordedAt     DateTime @default(now())

  @@index([controllerId, recordedAt])
  @@map("controller_locations")
}

