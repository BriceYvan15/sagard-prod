  nextCheckDate           DateTime?           @db.Date
  weaponCaliber           String?
  weaponAuthorization     String?
  weaponAuthorizationExp  DateTime?           @db.Date
  notes                   String?
  imageUrl                String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  movements               EquipmentMovement[]

  @@index([siteId, state])
  @@index([category, state])
  @@map("site_equipments")
}

model EquipmentMovement {
  id              String                @id @default(uuid())
  equipmentId     String
  equipment       SiteEquipment         @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  movementType    EquipmentMovementType
  date            DateTime              @default(now())
  employeeId      String?
  siteId          String?
  condition       EquipmentCondition    @default(BON)
  userId          String?               // recorded by
  notes           String?
  createdAt       DateTime              @default(now())

  @@index([equipmentId, date])
  @@map("equipment_movements")
}

