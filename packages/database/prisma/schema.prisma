model Incident {
  id                String              @id @default(uuid())
  reference         String              @unique
  title             String
  siteId            String
  site              Site                @relation(fields: [siteId], references: [id])
  incidentDatetime  DateTime            @default(now())
  incidentType      IncidentType
  severity          IncidentSeverity    @default(FAIBLE)
  state             IncidentState       @default(OUVERT)
  reporterId        String?
  dailyReportId     String?
  dailyReport       DailyReport?        @relation("IncidentDailyReport", fields: [dailyReportId], references: [id])
  controlVisitId    String?
  controlVisit      ControllerPatrol?   @relation("IncidentControlVisit", fields: [controlVisitId], references: [id])
  description       String
  actionsTaken      String?
  resolution        String?
  policeCalled      Boolean             @default(false)
  clientNotified    Boolean             @default(false)
  estimatedDamage   Decimal?            @db.Decimal(15, 2)
  currency          String              @default("XOF")
  attachmentUrls    String[]            @default([])
  opsReport         String?
  opsReportDate     DateTime?
  opsReportById     String?
  opsReportBy       User?               @relation("IncidentOpsReportBy", fields: [opsReportById], references: [id])
  opsReportState    OpsReportState      @default(PENDING)
  opsReportValidatedById String?
  opsReportValidatedBy   User?          @relation("IncidentOpsReportValidatedBy", fields: [opsReportValidatedById], references: [id])
  opsReportValidatedAt   DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  alerts            Alert[]             @relation("AlertIncident")
  involvedAgents    IncidentAgent[]

  @@index([siteId, incidentDatetime])
  @@index([state, severity])
  @@index([opsReportState])
  @@map("incidents")
}

model IncidentAgent {
  id          String   @id @default(uuid())
  incidentId  String
  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  agentId     String
  role        String?  // TÃƒÂ©moin, impliquÃƒÂ©, victime, etc.
  createdAt   DateTime @default(now())

  @@unique([incidentId, agentId])
  @@map("incident_agents")
}

