model Equipment {
  id              String          @id @default(uuid())
  code            String          @unique
  name            String
  category        String
  brand           String?
  model           String?
  serialNumber    String?         @unique
  purchaseDate    DateTime?
  purchasePrice   Decimal?        @db.Decimal(15, 2)
  status          EquipmentStatus @default(DISPONIBLE)
  photoUrl        String?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  assignments     EquipmentAssignment[]

  @@map("equipments")
}

model EquipmentAssignment {
  id              String     @id @default(uuid())
  equipmentId     String
  equipment       Equipment  @relation(fields: [equipmentId], references: [id])
  agentId         String
  agent           Agent      @relation(fields: [agentId], references: [id])
  assignedAt      DateTime   @default(now())
  returnedAt      DateTime?
  assignedBy      String
  returnCondition String?
  photoUrl        String?
  notes           String?

  @@map("equipment_assignments")
}

model Vehicle {
  id            String        @id @default(uuid())
  plateNumber   String        @unique
  type          VehicleType
  brand         String
  model         String
  year          Int?
  status        VehicleStatus @default(DISPONIBLE)
  assignedTo    String?
  fuelType      String        @default("Essence")
  mileage       Int           @default(0)
  photoUrl      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  fuelLogs      FuelLog[]
  maintenances  Maintenance[]

  @@map("vehicles")
}

model FuelLog {
  id          String   @id @default(uuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  date        DateTime @default(now())
  liters      Float
  pricePerL   Decimal  @db.Decimal(10, 2)
  totalCost   Decimal  @db.Decimal(15, 2)
  mileageAt   Int?
  filledBy    String
  notes       String?

  @@map("fuel_logs")
}

model Maintenance {
  id          String   @id @default(uuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  type        String
  description String?
  cost        Decimal? @db.Decimal(15, 2)
  startDate   DateTime
  endDate     DateTime?
  provider    String?
  notes       String?
  createdAt   DateTime @default(now())

