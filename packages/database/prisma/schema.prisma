model VisitorLog {
  id              String        @id @default(uuid())
  reference       String        @unique
  siteId          String
  site            Site          @relation(fields: [siteId], references: [id])
  visitorName     String
  visitorCompany  String?
  visitorPhone    String?
  idType          IdDocType     @default(CNI)
  idNumber        String?
  visitPurpose    VisitPurpose  @default(REUNION)
  hostName        String?
  plateNumber     String?
  checkIn         DateTime      @default(now())
  checkOut        DateTime?
  durationMin     Float?        // computed
  badgeNo         String?
  badgeReturned   Boolean       @default(false)
  agentId         String?       // agent who registered
  agent           User?         @relation(fields: [agentId], references: [id])
  photoUrl        String?
  notes           String?
  isBlacklisted   Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  keyMovements    KeyMovement[] @relation("KeyMovementVisitor")

  @@index([siteId, checkIn])
  @@index([idNumber])
  @@map("visitor_logs")
}

model Blacklist {
  id            String          @id @default(uuid())
  name          String
  idNumber      String?
  reason        BlacklistReason
  description   String?
  photoUrl      String?
  incidentId    String?
  dateStart     DateTime        @default(now()) @db.Date
  dateEnd       DateTime?       @db.Date
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())

  sites         BlacklistSite[]

  @@index([idNumber])
  @@map("blacklists")
}

model BlacklistSite {
  id           String    @id @default(uuid())
  blacklistId  String
  blacklist    Blacklist @relation(fields: [blacklistId], references: [id], onDelete: Cascade)
  siteId       String
  site         Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([blacklistId, siteId])
  @@map("blacklist_sites")
}

