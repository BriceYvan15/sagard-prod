model User {
  id            String     @id @default(uuid())
  email         String     @unique
  phone         String     @unique
  passwordHash  String
  role          Role
  status        UserStatus @default(ACTIF)
  firstName     String
  lastName      String
  photoUrl      String?
  whatsappPhone String?
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  agent          Agent?
  client         ClientContact?
  notifications  Notification[]
  auditLogs      AuditLog[]
  sessions       UserSession[]
  visitorLogs    VisitorLog[]
  transferDecisions AgentTransfer[] @relation("TransferDecidedBy")
  incidentOpsReports       Incident[] @relation("IncidentOpsReportBy")
  incidentOpsValidations   Incident[] @relation("IncidentOpsReportValidatedBy")
  terminatedAgents         Agent[]    @relation("AgentTerminatedBy")

  @@map("users")
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  deviceInfo   String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@map("user_sessions")
}

